# ===================================================
# Listify Web Ortam Değişkenleri
# ===================================================

# Veritabanı Yapılandırması (MySQL)
MYSQL_ROOT_PASSWORD=listify_root_secret_pass
MYSQL_DATABASE=listify
MYSQL_USER=listify_user
MYSQL_PASSWORD=listify_user_secure_pass
MYSQL_HOST=db
MYSQL_PORT=3306

# API Servisi Yapılandırması
PORT=8080
NODE_ENV=production
TTL_HOURS=48
CLEANUP_CRON_SCHEDULE="0 * * * *"

# Web Frontend Yapılandırması (Next.js)
WEB_PORT=3000
# İstemci tarafı API adresi: Statik IP üzerinde çalışırken /api/v1 Nginx tarafından yönlendirilir
NEXT_PUBLIC_API_URL=/api/v1
